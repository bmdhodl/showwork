# Ledger files are integrity-chained JSONL. Never EOL-rewrite them: the
# chain hash is EOL-agnostic, but keeping bytes stable avoids noise.
.showwork/** -text
tests/fixtures/** -text

# Concurrent leftover files can still union-merge. Per-session files from
# distinct slugs do not share a path; union merge is not the scaler.
# See docs/concurrency.md.
.showwork/**/*.jsonl merge=union
.showwork/*.jsonl merge=union
